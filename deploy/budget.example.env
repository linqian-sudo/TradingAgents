# 研究预算示例。没有密钥。金额是人民币十进制字符串。
# 价格卡过期、模型不在卡内、或请求没有 token 上界时，入口拒绝发送。

# 腾讯 0700.HK 的多角色研究预算。没有密钥。
# 两个层级都用 deepseek-flash。总预算 9.5 元，含此前基础调用的保守预留。
TRADINGAGENTS_LLM_PROVIDER=deepseek
TRADINGAGENTS_QUICK_THINK_LLM=deepseek-flash
TRADINGAGENTS_DEEP_THINK_LLM=deepseek-flash
TRADINGAGENTS_BUDGET_CNY=9.5
# 已发生的保守占用，含历史整计划预留、基础预留和已知用量。不要改小或清零。
# 组成：0.955264 * 2 + 0.008448 + 0.040622 = 1.959598
TRADINGAGENTS_PRIOR_HOLD_CNY=1.959598
TRADINGAGENTS_MAX_RETRIES=0
# 1024 已在实测中截断 7 次角色输出。4096 提高单次输出上界，最坏费用见 budget 命令。
TRADINGAGENTS_MAX_TOKENS=4096
# 输入上界由入口按每次真实请求测量。思考模式保持关闭。
