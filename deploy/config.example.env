# 研究入口示例配置。全部是空的占位，不含密钥。
# 复制为安装目录之外的私有文件后再填写，不要提交到公开仓库。
# 未填写时，tradingagents-research run 会以「模型未配置」结束，不会调用模型。

# 选择一个 provider。不设置时不会回落到付费默认模型。
#TRADINGAGENTS_LLM_PROVIDER=
#TRADINGAGENTS_QUICK_THINK_LLM=
#TRADINGAGENTS_DEEP_THINK_LLM=

# 本地或兼容端点（不承诺费用；本地服务本身不在本包内启动）
# 例：ollama 可不填 Key，需要本机已有服务。openai_compatible 必须填 URL。
#OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
#TRADINGAGENTS_LLM_BACKEND_URL=
#OPENAI_COMPATIBLE_API_KEY=

# 托管服务只填所选 provider 的一个变量。下面只列出名称。
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#GOOGLE_API_KEY=
#DEEPSEEK_API_KEY=
#DASHSCOPE_API_KEY=
#DASHSCOPE_CN_API_KEY=
#ZHIPU_API_KEY=
#ZHIPU_CN_API_KEY=
#MINIMAX_API_KEY=
#MINIMAX_CN_API_KEY=
#OPENROUTER_API_KEY=
#GROQ_API_KEY=
#MOONSHOT_API_KEY=
#MISTRAL_API_KEY=
#NVIDIA_API_KEY=
#XAI_API_KEY=
#AZURE_OPENAI_API_KEY=

# 研究入口默认上限。这是调用上限，不是付费方案；改大之前先向服务商确认价格。
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
#TRADINGAGENTS_MAX_TOOL_ROUNDS=8
#TRADINGAGENTS_MAX_TOKENS=4096
#TRADINGAGENTS_REQUEST_TIMEOUT=120
#TRADINGAGENTS_LLM_MAX_RETRIES=2
#TRADINGAGENTS_OUTPUT_LANGUAGE=Chinese

# 关闭上游在交互终端里的版本公告访问。
TRADINGAGENTS_NO_UPDATE_CHECK=1

# 行情连通性不需要下面这些变量。完整上游图里的宏观数据才会用到 FRED。
#FRED_API_KEY=
#ALPHA_VANTAGE_API_KEY=
